{
  "expo": {
    
    "name": "Class Attendance Portal",
    "description": "Class Attendance Portal",
    "author": "Inan Ahammad <user.grinch@gmail.com>",
    "slug": "class-attendance-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "class-attendance-portal",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.grinch.classattendanceportal"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to register your face and take class photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to choose class photos for face attendance.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take class photos for face attendance."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}