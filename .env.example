# Frontend Server Ports
# Port for production web serving (e.g. pm2 serve web-build 3000)
PORT=3000

# Port for local Expo dev server
EXPO_PORT=8081

# Public API & Web configuration
# Local Development:
EXPO_PUBLIC_API_PORT=8000
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_WEB_PORT=3000
EXPO_PUBLIC_WEB_URL=http://localhost:8081

